# ---- required ----
# Long random string. Every /api request must present it (UI asks once).
COPYPAGE_TOKEN=change-me-openssl-rand-hex-32

# ---- reverse proxy ----
# ":80" = plain HTTP for private/VPN use. A real domain enables automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- service policy ----
# Agent-driven generation needs pi credentials (see README) and is a
# shell-access trust decision: keep false until you have reviewed that.
COPYPAGE_ALLOW_AGENT=false
COPYPAGE_AGENT_MODEL=
COPYPAGE_AGENT_MAX_ROUNDS=8
COPYPAGE_AGENT_TIMEOUT_MIN=30

# Host path mounted at /root/.pi inside the container (settings + credentials).
# Set to your home pi dir, e.g. PI_CONFIG_PATH=/home/you/.pi
PI_CONFIG_PATH=./pi-config

# Server-side `npm run build` for uploaded repros = arbitrary code execution.
# Leave false and upload prebuilt dist/ instead.
COPYPAGE_ALLOW_BUILD=false

COPYPAGE_MAX_TASKS=50
COPYPAGE_MAX_UPLOAD_MB=200
COPYPAGE_RETENTION_HOURS=168
COPYPAGE_RATE_LIMIT_PER_MINUTE=120

# the app port is not published; every request arrives through Caddy
COPYPAGE_TRUST_PROXY=true

# Chromium in a container refuses to start as root with its sandbox enabled
COPYPAGE_CHROMIUM_ARGS=--no-sandbox
