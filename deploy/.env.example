# ============================================================
# CopyPage 部署配置模板 —— 复制为 deploy/.env 后按需修改
#   cp deploy/.env.example deploy/.env
# 必填项只有 COPYPAGE_TOKEN(或 ADMIN_EMAIL/PASSWORD 二选一)
# 检查配置:./deploy/check.sh
# ============================================================

# ------------------------------------------------------------
# 1. 访问控制(必填其一)
# ------------------------------------------------------------
# 运维/健康检查/API 用的共享令牌;UI 右上角填入即可访问
# 生成:openssl rand -hex 32
COPYPAGE_TOKEN=change-me-openssl-rand-hex-32

# 多租户模式的引导管理员(首次启动自动创建,UI 登录用)
COPYPAGE_ADMIN_EMAIL=
COPYPAGE_ADMIN_PASSWORD=

# 是否开放自助注册(false = 只有管理员能建号)
COPYPAGE_ALLOW_REGISTRATION=false

# ------------------------------------------------------------
# 2. 反向代理(方式 B: Docker Compose / 直接暴露)
# ------------------------------------------------------------
# ":80" = 明文 HTTP(内网/VPN 用);填真实域名则自动申请 HTTPS 证书
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# 只有所有请求都经过反代时才开(用于按真实 IP 限流/审计)
COPYPAGE_TRUST_PROXY=true

# ------------------------------------------------------------
# 3. 邮件(Resend)—— 邮箱验证 / 找回密码 / 用户提醒 / 运维告警
# ------------------------------------------------------------
# 不填则邮件只打印到日志(本地测试可用)
COPYPAGE_RESEND_API_KEY=
# 必须是在 Resend 验证过的域名下的地址
COPYPAGE_EMAIL_FROM=CopyPage <no-reply@your-domain>
# 邮件里链接的基址(部署后的对外地址)
COPYPAGE_APP_URL=http://localhost:4400
# true = 未验证邮箱不能提交任务(推荐公网开启)
COPYPAGE_REQUIRE_EMAIL_VERIFICATION=false
# 运维告警收件人(队列积压/失败率/磁盘/封禁尝试/连续失败)
COPYPAGE_ADMIN_ALERT_EMAIL=

# ------------------------------------------------------------
# 4. 配额与资源(默认值基本够用)
# ------------------------------------------------------------
COPYPAGE_MAX_TASKS=50               # 单实例任务总数上限
COPYPAGE_MAX_UPLOAD_MB=200          # 验证用 zip 上限
COPYPAGE_RETENTION_HOURS=168        # 产物保留时长(过期自动清理)
COPYPAGE_RATE_LIMIT_PER_MINUTE=120  # 每用户(未登录按 IP)每分钟请求数
COPYPAGE_WORKER_CONCURRENCY=2       # 并行任务数 ≈ CPU 核数
COPYPAGE_WORKER_MEMORY_MB=3072      # 单个 worker 进程堆上限

# ------------------------------------------------------------
# 5. 生成能力(可选,agent 有 shell 权限)
# ------------------------------------------------------------
COPYPAGE_ALLOW_AGENT=false
COPYPAGE_AGENT_MODEL=               # 例如 sonnet:high
COPYPAGE_AGENT_MAX_ROUNDS=8
COPYPAGE_AGENT_TIMEOUT_MIN=30
# pi 配置目录(仅 Docker 方式;指向宿主 ~/.pi)
PI_CONFIG_PATH=./pi-config

# 服务端执行上传工程的 npm run build = 任意代码执行,保持关闭,
# 让用户提交已构建好的 dist/ 或静态目录
COPYPAGE_ALLOW_BUILD=false

# ------------------------------------------------------------
# 6. 任务隔离(可选,推荐公网开启)
# ------------------------------------------------------------
# process = 每任务一个子进程;docker = 每任务一个容器(需 docker 组权限)
COPYPAGE_SANDBOX=process
COPYPAGE_WORKER_IMAGE=copypage-server:local
COPYPAGE_WORKER_NETWORK=bridge
COPYPAGE_WORKER_CPUS=1
COPYPAGE_WORKER_PIDS_LIMIT=256
# Docker/容器内必须 --no-sandbox;systemd 直接跑(非 root)可留空
COPYPAGE_CHROMIUM_ARGS=--no-sandbox

# ------------------------------------------------------------
# 7. 多主机状态(可选:Postgres + NFS 共享产物卷)
# ------------------------------------------------------------
# COPYPAGE_DATABASE_URL=postgres://copypage:secret@db-host:5432/copypage

# ------------------------------------------------------------
# 8. 可观测
# ------------------------------------------------------------
COPYPAGE_LOG_FORMAT=text     # json = 结构化日志(便于采集)
COPYPAGE_METRICS_OPEN=false  # /metrics:loopback 免鉴权,外部需管理员
